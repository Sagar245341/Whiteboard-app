PORT=3000
# Optional: Neon Postgres connection string. Without it, data is saved to ./data/store.json.
DATABASE_URL=
# Optional: enables real AI tools. Without it, the UI clearly reports AI is not configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set a long random secret in production. Local development creates a persistent secret automatically.
JWT_SECRET=
# Optional: verify external Neon Auth access tokens against your project's JWKS endpoint.
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
# Optional: switches sign-up and sign-in to managed Neon Auth.
VITE_NEON_AUTH_URL=
# Optional: Neon Object Storage / S3-compatible storage. Otherwise images are stored locally.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
